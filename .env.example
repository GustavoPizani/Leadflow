# Mesmo Postgres/Supabase do Real-Sales. Nunca aponte para outro projeto.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Necessária - usada server-side para criar contas novas de gestor/corretor via Admin API.
SUPABASE_SERVICE_ROLE_KEY=""

# Meta (Facebook/Instagram Lead Ads) — mesmo App do Real-Sales. Só usado aqui para o OAuth de
# conexão (tokens de página) e chamadas à Graph API. O Leadflow nunca recebe webhook do Meta
# diretamente — quem recebe é o Real-Sales, que repassa para /api/meta/ingest.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Base pública deste projeto, usada para montar o redirect_uri do OAuth do Meta.
NEXT_PUBLIC_SITE_URL=""

# Segredo compartilhado com o Real-Sales — precisa ser idêntico ao LEADFLOW_INTERNAL_SECRET
# configurado no .env do Real-Sales. Só quem tiver esse valor pode chamar /api/meta/ingest.
LEADFLOW_INTERNAL_SECRET=""

# Web Push (notificação de novo lead). Gerar com `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL=""

# Segredo dedicado pra integração com planilha de feedback (Apps Script -> GET
# /api/integrations/leads-export). Só leitura de leads, escopo separado do LEADFLOW_INTERNAL_SECRET.
SHEETS_EXPORT_SECRET=""
